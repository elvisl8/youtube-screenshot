{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "截取当前 YouTube 视频帧"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "capture-frame": {
      "description": "截取当前 YouTube 视频帧",
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "MacCtrl+Shift+S"
      }
    }
  },
  "content_scripts": [
    {
      "all_frames": false,
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "播放 YouTube 时一键截取当前视频帧：播放器按钮、快捷键、弹窗三种入口；原生分辨率干净画面（无控制条），可保存 PNG/JPG/WebP 或复制到剪贴板。",
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "YouTube 截屏 - Video Screenshot",
  "options_page": "options.html",
  "permissions": [
    "storage",
    "activeTab",
    "downloads",
    "scripting"
  ],
  "version": "1.0"
}